<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="0"
                        android:endColor="#664A68"
                        android:startColor="#6BA39A" />
                    <corners android:radius="50dp" />
                    <stroke android:width="3dp" android:color="#66FFFFFF" />
                </shape>
            </item>
            <item android:height="14dp" android:gravity="top" android:left="30dp" android:right="30dp" android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#55FFFFFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="50dp" />
        </shape>
    </item>
</ripple>
