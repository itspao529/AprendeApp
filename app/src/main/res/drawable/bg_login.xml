<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#A58BA8"
                android:endColor="#6BA39A"
                android:startColor="#F3B7B5" />
        </shape>
    </item>
    <item android:width="220dp" android:height="220dp" android:gravity="top|end" android:right="-70dp" android:top="-60dp">
        <shape android:shape="oval"><solid android:color="#30FFFFFF" /></shape>
    </item>
    <item android:width="140dp" android:height="140dp" android:gravity="bottom|start" android:left="-40dp" android:bottom="60dp">
        <shape android:shape="oval"><solid android:color="#2EFFFFFF" /></shape>
    </item>
    <item android:width="90dp" android:height="90dp" android:gravity="top|start" android:left="30dp" android:top="120dp">
        <shape android:shape="oval"><solid android:color="#3AFFFFFF" /></shape>
    </item>
    <item android:width="50dp" android:height="50dp" android:gravity="bottom|end" android:right="40dp" android:bottom="110dp">
        <shape android:shape="oval"><solid android:color="#40FFFFFF" /></shape>
    </item>
    <item android:width="26dp" android:height="26dp" android:gravity="top|end" android:right="90dp" android:top="200dp">
        <shape android:shape="oval"><solid android:color="#50FFFFFF" /></shape>
    </item>
    <item android:width="34dp" android:height="34dp" android:gravity="bottom|start" android:left="110dp" android:bottom="30dp">
        <shape android:shape="oval"><solid android:color="#45FFFFFF" /></shape>
    </item>
</layer-list>
