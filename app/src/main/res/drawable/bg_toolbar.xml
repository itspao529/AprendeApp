<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135"
                android:startColor="#A58BA8" android:centerColor="#8A6E8D" android:endColor="#664A68" />
            <corners android:bottomLeftRadius="40dp" android:bottomRightRadius="40dp" />
        </shape>
    </item>
    <item android:width="110dp" android:height="110dp" android:gravity="top|end" android:right="60dp" android:top="-40dp">
        <shape android:shape="oval"><solid android:color="#26FFFFFF" /></shape>
    </item>
    <item android:width="46dp" android:height="46dp" android:gravity="bottom|end" android:right="24dp" android:bottom="10dp">
        <shape android:shape="oval"><solid android:color="#33FFFFFF" /></shape>
    </item>
    <item android:width="24dp" android:height="24dp" android:gravity="bottom|start" android:left="150dp" android:bottom="8dp">
        <shape android:shape="oval"><solid android:color="#40FFFFFF" /></shape>
    </item>
</layer-list>
