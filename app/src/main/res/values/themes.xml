<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.RecursosDeAprendizaje" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rosa</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/rosa_claro</item>
        <item name="colorOnPrimaryContainer">#3E0021</item>
        <item name="colorSecondary">@color/lila</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/lila_claro</item>
        <item name="colorOnSecondaryContainer">#2A0A4A</item>
        <item name="android:colorBackground">@color/rosa_fondo</item>
        <item name="colorSurface">@color/rosa_fondo</item>
        <item name="colorSurfaceContainerLow">@color/rosa_superficie</item>
        <item name="colorSurfaceContainer">@color/rosa_superficie</item>
        <item name="colorSurfaceContainerHigh">@color/rosa_claro</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Large</item>
    </style>

    <style name="Theme.RecursosDeAprendizaje" parent="Base.Theme.RecursosDeAprendizaje" />

    <!-- Esquinas más redondeadas -->
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
